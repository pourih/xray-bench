# GitHub Sync Credentials for publishing node lists
# Create a Personal Access Token (classic or fine-grained) with 'repo' or 'contents:write' permissions
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Target repository in the format "owner/repo" (e.g., "octocat/my-proxy-nodes")
GITHUB_REPO=your_username/your_repo_name

# Target branch to commit and push output files to (defaults to main)
GITHUB_BRANCH=main
