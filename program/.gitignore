# Environment & Secrets
.env
.env.*
!.env.example

# Binaries and platform downloads
bin/*
!bin/.gitkeep
!bin/README.md

# User Data (subscriptions, custom nodes, blacklists, databases)
/data/*
!/data/.gitkeep
!/data/*.example

# Databases
*.db
*.sqlite
*.sqlite3
*.bak*

# Python & testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Logs & temp
*.log
.temp/
tmp/
