# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dat binary
*.exe binary
*.dll binary
*.so binary
*.db binary
*.sqlite binary
